{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "黄河影像征集核验领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "SUBMISSION_RECEIVED",
        "EVIDENCE_REQUESTED",
        "RIGHTS_CLEARED",
        "ASSET_EDITED",
        "VARIANT_PUBLISHED",
        "WORK_REGISTERED",
        "CLIP_REGISTERED",
        "DECLARATION_SUBMITTED",
        "CREDENTIAL_SUBMITTED",
        "REDACTION_REGISTERED",
        "ASSOCIATION_SUGGESTED",
        "MERGE_DECIDED",
        "CLIP_REPLACED",
        "REVIEW_REQUESTED",
        "REVIEW_RESOLVED",
        "BASIS_FROZEN",
        "PUBLICATION_REJECTED",
        "CONSENT_WITHDRAWN",
        "CREDENTIAL_WITHDRAWN",
        "DISPOSITION_RECORDED",
        "CREDENTIAL_CONFIRMED",
        "WITHDRAWAL_NOTIFIED",
        "RECORD_QUARANTINED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "submission",
        "media_asset",
        "rights_record",
        "publication_variant",
        "work",
        "media_clip",
        "declaration",
        "rights_credential",
        "redacted_variant",
        "association",
        "publication",
        "quarantine"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
