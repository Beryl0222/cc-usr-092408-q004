{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "黄河影像征集核验领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "BATCH_RECEIVED",
        "SUBMISSION_RECEIVED",
        "WORK_REGISTERED",
        "CLIP_REGISTERED",
        "DECLARATION_RECORDED",
        "CREDENTIAL_RECORDED",
        "WORKS_ASSOCIATED",
        "WORKS_MERGED",
        "WORK_QUARANTINED",
        "WORK_QUARANTINE_RESOLVED",
        "EVIDENCE_REQUESTED",
        "VERIFICATION_REQUESTED",
        "VERIFICATION_ASSIGNED",
        "VERIFICATION_APPROVED",
        "VERIFICATION_REJECTED",
        "RIGHTS_CLEARED",
        "PARTNER_CONFIRMATION_REQUESTED",
        "PARTNER_CONFIRMED",
        "PARTNER_DECLINED",
        "PUBLICATION_BASIS_FROZEN",
        "PUBLICATION_RELEASED",
        "CONSENT_WITHDRAWN",
        "POST_PUBLICATION_ACTION_APPENDED",
        "ASSET_EDITED",
        "CLIP_REPLACED",
        "SANITIZED_VARIANT_CREATED",
        "VARIANT_PUBLISHED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "processing_batch",
        "submission",
        "work",
        "media_clip",
        "declaration",
        "rights_record",
        "verification_case",
        "publication_basis",
        "publication",
        "publication_variant"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "request_id": {
      "type": "string"
    },
    "payload": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
